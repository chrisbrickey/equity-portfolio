# AlphaVantage API Key (REQUIRED for stock price features)
# Get a free API key at: https://www.alphavantage.co/support/#api-key and paste below
ALPHA_KEY=your_alphavantage_api_key_here

# Django Secret Key (REQUIRED for app to start)
# This insecure default is sufficient for local development if you are only handling test/seed data.
# In production, set a real cryptographic key.
SECRET_KEY=django-insecure-local-dev-key-change-in-production